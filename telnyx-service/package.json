{
  "name": "web-dev-advisor-telnyx-service",
  "version": "1.0.0",
  "description": "Standalone Telnyx Programmable Voice & Messaging webhook service for Web Dev Advisor LLC",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.19.2",
    "telnyx": "^3.0.0",
    "zod": "^3.23.8",
    "dotenv": "^16.4.5",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/uuid": "^9.0.7",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1"
  }
}