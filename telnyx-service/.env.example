# ============================================================
# Web Dev Advisor LLC — Telnyx Voice & Messaging Service
# Copy this file to .env and fill in real values before running.
# ============================================================

# --- Service runtime ---
PORT=3000
NODE_ENV=development
HOST=0.0.0.0

# --- Telnyx API (Programmable Voice + Messaging) ---
# Generate at: https://portal.telnyx.com → API Keys
TELNYX_API_KEY=REPLACE_WITH_YOUR_TELNYX_API_KEY
TELNYX_PUBLIC_KEY=REPLACE_WITH_YOUR_TELNYX_PUBLIC_KEY

# --- Telnyx Connection / Call Control ---
# Connection ID used to originate outbound calls & send SIP URIs
TELNYX_CONNECTION_ID=REPLACE_WITH_YOUR_CONNECTION_ID
# The California DID receiving inbound calls
TELNYX_CALIFORNIA_DID=+14155550100

# --- Forwarding targets ---
# US-based Sales agents (E.164), comma-separated fallback chain
SALES_PRIMARY_NUMBERS=+14155550120,+14155550121
# International Support agents reachable via SIP softphone
SUPPORT_SIP_URIS=sip:alice@your-sip-domain.com,sip:bob@your-sip-domain.com

# --- Failover ---
# Seconds before cascading to a backup destination (default 15)
FAILOVER_TIMEOUT_SECONDS=15

# --- Messaging ---
# Outbound SMS/MMS sending (uses same TELNYX_API_KEY)
TELNYX_MESSAGING_PROFILE_ID=REPLACE_WITH_YOUR_MESSAGING_PROFILE_ID
TELNYX_MESSAGING_FROM_NUMBER=+14155550100

# --- Webhook forwarding to Django ---
# Django REST endpoint that receives forwarded messages & voicemail alerts
DJANGO_API_BASE_URL=http://localhost:8000
DJANGO_WEBHOOK_SECRET=REPLACE_WITH_A_SHARED_SECRET
DJANGO_MESSAGE_ENDPOINT=/api/v1/external/telnyx/messages/
DJANGO_VOICEMAIL_ENDPOINT=/api/v1/external/telnyx/voicemail/

# --- Voicemail storage (Telnyx) ---
TELNYX_VOICEMAIL_BUCKET=REPLACE_WITH_YOUR_VOICEMAIL_STORAGE_BUCKET_ID

# --- Email alerts (SendGrid fallback for voicemail notifications) ---
SENDGRID_API_KEY=REPLACE_WITH_YOUR_SENDGRID_API_KEY
VOICEMAIL_ALERT_FROM=noreply@webdevadvisor.io
VOICEMAIL_ALERT_TO=alerts@webdevadvisor.io